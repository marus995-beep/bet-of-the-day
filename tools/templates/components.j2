{% macro src_ref(index) -%}
{% if index %}<sup class="src-ref"><a href="#source-{{ index }}">{{ index }}</a></sup>{% endif %}
{%- endmacro %}

{% macro stat_tile(stat) %}
<div class="stat-tile">
  <div class="stat-label">{{ stat.label }}</div>
  <div class="stat-value">{{ stat.value }}{{ src_ref(stat.source_index) }}</div>
  {% if stat.delta %}
  <div class="stat-delta {{ stat.delta_class }}">{{ stat.delta_glyph }} {{ stat.delta }}</div>
  {% endif %}
</div>
{% endmacro %}

{% macro comparison_bars(section) %}
<div class="comparison-bars">
  {% for item in section["items"] %}
  <div class="bar-row">
    <div class="bar-label">{{ item.label }}{{ src_ref(item.source_index) }}</div>
    <div class="bar-track">
      <div class="bar-fill" style="width: {{ item.pct }}%; background: var({{ item.color_var }});"></div>
    </div>
    <div class="bar-value">{{ item.display_value }}</div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro sparkline(section) %}
<div class="trend-block">
  <div class="trend-label">
    {{ section.label }}{% if section.unit %} <span class="trend-unit">({{ section.unit }})</span>{% endif %}{{ src_ref(section.source_index) }}
  </div>
  <svg class="trend-svg" viewBox="0 0 {{ section.svg.width }} {{ section.svg.height }}" role="img" aria-label="{{ section.label }} trend">
    <polyline fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"
      points="{{ section.svg.polyline }}" />
    {% for dot in section.svg.dots %}
    <circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="{{ 4 if dot.is_last else 2 }}" fill="var(--accent)"
      {% if dot.is_last %}stroke="var(--surface)" stroke-width="2"{% endif %} />
    {% endfor %}
  </svg>
  <div class="trend-axis">
    {% for label in section.point_labels %}<span>{{ label }}</span>{% endfor %}
  </div>
</div>
{% endmacro %}

{% macro quote_block(section) %}
<blockquote class="quote-block">
  <p>&ldquo;{{ section.text }}&rdquo;{{ src_ref(section.source_index) }}</p>
  {% if section.attribution %}<cite>{{ section.attribution }}</cite>{% endif %}
</blockquote>
{% endmacro %}

{% macro icon_list(section) %}
<ul class="icon-list">
  {% for item in section["items"] %}
  <li><span class="icon-glyph">{{ section.icon_glyph }}</span><span>{{ item }}</span></li>
  {% endfor %}
</ul>
{% endmacro %}
